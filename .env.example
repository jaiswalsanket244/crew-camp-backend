# Redis Cloud Configuration
# Format: redis[s]://[[username][:password]@]host[:port][/db]
REDIS_URL=redis://default:passwðord@your-redis-cloud-endpoint.redis.com:16379/0

# Cloudflare Turnstile — server-side siteverify secret key (web CAPTCHA).
# Leave unset to disable enforcement (middleware fails open with a warning).
TURNSTILE_SECRET_KEY=xxxxxxxxxxxxxxxxxxxx

# OpenSearch / Search Configuration (Story 1.2)
# Endpoint is required (verifyEnvBackEnd asserts it in non-test envs). Region is a code
# constant (config.ts, us-east-1) — NOT an env var.
# Staging uses FGAC username/password (from Secrets Manager crewcam/search/staging);
# production uses sigv4 via OPENSEARCH_SIGV4_ROLE / instance role (leave user/pass empty).
OPENSEARCH_ENDPOINT=xxxxxxxx
OPENSEARCH_USERNAME=xxxxxxxx
OPENSEARCH_PASSWORD=xxxxxxxx

# Baseline latency metrics (Story 1.6) — now a code constant (config.ts), not an env var.

SENTRY_ORG_SLUG=xxxxxxxx
SENTRY_PROJECT_ID=xxxxxxxx
SENTRY_ORG_TOKEN=xxxxxxxx
SENTRY_PROJECT_SLUG=xxxxxxxx

# Proline CRM (both optional — code defaults to these values)
PROLINE_APP_URL=https://new.proline.app
PROLINE_API_URL=https://api.proline.app
# Partner token issued to CrewCam by Proline (required for outbound Proline API calls)
PROLINE_PARTNER_KEY=
