{
  "name": "portfolio-dashboard",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "tsc-watch": "node scripts/verifyEnvBackEnd && baml-cli generate && tsc --watch",
    "tsc": "node scripts/verifyEnvBackEnd.js && baml-cli generate && tsc",
    "production": "cross-env NODE_ENV=PRODUCTION node server/index.js",
    "server": "cross-env NODE_ENV=dev nodemon server/index.js",
    "cron-server": "cross-env NODE_ENV=dev nodemon server/cron/cron.js",
    "search-worker": "cross-env NODE_ENV=dev nodemon scripts/searchWorker.js",
    "production-search-worker": "cross-env NODE_ENV=PRODUCTION node scripts/searchWorker.js",
    "deploy-search-dashboard": "node scripts/deploySearchDashboard.js",
    "search-parity": "node scripts/searchParity.js",
    "server-test": "cross-env NODE_ENV=test node scripts/verifyEnvBackEnd.js && baml-cli generate && cross-env NODE_ENV=test tsc && cross-env NODE_ENV=test mocha test --timeout 10000 --exit",
    "lint": "eslint --ignore-path .gitignore --ext .ts .",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "precommit": "lint-staged",
    "baml": "baml-cli generate"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "pre-commit": [
    "precommit"
  ],
  "lint-staged": {
    "*.ts": [
      "eslint --ignore-path .eslintignore",
      "prettier --ignore-path .gitignore --write"
    ],
    "*.{js,json}": [
      "prettier --ignore-path .gitignore --write"
    ]
  },
  "private": true,
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1075.0",
    "@aws-sdk/client-s3": "^3.433.0",
    "@aws-sdk/client-sqs": "^3.1030.0",
    "@aws-sdk/credential-provider-node": "^3.972.58",
    "@aws-sdk/s3-request-presigner": "^3.940.0",
    "@boundaryml/baml": "^0.226.2",
    "@nishantsingh/dookie": "^0.0.3",
    "@opensearch-project/opensearch": "^3.6.0",
    "@sendgrid/mail": "^7.7.0",
    "@types/express": "^4.17.20",
    "@types/geojson": "^7946.0.12",
    "@types/http-status": "^0.2.30",
    "@types/multer": "^1.4.11",
    "@types/redis": "^4.0.10",
    "@types/socket.io": "3.0.1",
    "@types/stripe-v3": "^3.1.31",
    "atob": "^2.1.2",
    "aws-sdk": "^2.1476.0",
    "axios": "^1.5.1",
    "chai-http": "^4.4.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.10",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.0",
    "ffmpeg-static": "^5.3.0",
    "firebase": "^10.5.0",
    "firebase-admin": "^11.11.0",
    "form-data": "^4.0.5",
    "http-status": "^1.7.3",
    "jsonwebtoken": "^9.0.2",
    "jwplatform": "^0.0.6",
    "lint-staged": "^15.0.1",
    "lodash.debounce": "^4.0.8",
    "mask-json": "^1.0.3",
    "mongoose": "^7.6.3",
    "multer": "^1.4.5-lts.1",
    "nock": "^13.3.4",
    "node-2fa": "^2.0.3",
    "node-cron": "^3.0.2",
    "node-geocoder": "^4.2.0",
    "node-input-validator": "^4.5.1",
    "node-url-shortener": "^2.0.3",
    "nodemon": "^3.0.1",
    "openai": "^6.27.0",
    "puppeteer": "^24.43.1",
    "redis": "^5.12.1",
    "sharp": "^0.35.3",
    "standard-error": "^1.1.0",
    "stream-chat": "^8.13.1",
    "stripe": "^14.25.0",
    "striptags": "^3.2.0",
    "tslib": "^2.6.2",
    "twilio": "^4.18.1",
    "validator": "^13.11.0",
    "winston": "^3.11.0",
    "winston-aws-cloudwatch": "^3.0.0",
    "yaml": "^2.3.3"
  },
  "devDependencies": {
    "@types/chai": "^4.3.9",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.3",
    "@types/node": "^20.19.19",
    "@typescript-eslint/eslint-plugin": "^6.8.0",
    "@typescript-eslint/parser": "^6.8.0",
    "chai": "^4.3.10",
    "chai-http": "^4.4.0",
    "eslint": "^8.51.0",
    "mocha": "^10.2.0",
    "pre-commit": "1.2.2",
    "prettier": "^3.0.3",
    "sinon": "^21.0.1",
    "ts-node": "^10.9.1",
    "typescript": "~5.2.2"
  }
}
